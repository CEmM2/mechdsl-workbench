MECHDSL_WORKBENCH_HOST=127.0.0.1
MECHDSL_WORKBENCH_PORT=8000
MECHDSL_WORKBENCH_DEBUG=0
MECHDSL_WORKBENCH_COMPILE_TIMEOUT=30
MECHDSL_WORKBENCH_MAX_CONCURRENT_COMPILES=2
MECHDSL_WORKBENCH_MAX_SOURCE_BYTES=262144
MECHDSL_WORKBENCH_MAX_WORKER_OUTPUT_BYTES=8388608
MECHDSL_WORKBENCH_MAX_REQUEST_BYTES=2097152
# Set to an empty value to disable browser-side MathJax loading.
MECHDSL_WORKBENCH_MATHJAX_URL=https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-chtml.js
MECHDSL_WORKBENCH_SUPPORTED_MECHDSL=>=0.2.0,<0.3.0
